# Server configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beamdesk?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_ACCESS_SECRET="beamdesk_access_super_secret_key_change_in_production_min_32_chars"
JWT_REFRESH_SECRET="beamdesk_refresh_super_secret_key_change_in_production_min_32_chars"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# WebRTC STUN/TURN configuration
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
